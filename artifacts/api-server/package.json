{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:teacher-review": "tsx --test src/lib/review-security-policy.test.ts && node ./test-scholarly-http.mjs --teacher-review",
    "test:daily-plan": "tsx --test src/lib/daily-plan-policy.test.ts && node ./test-daily-plan.mjs",
    "test:scholarly:collation": "node ./test-scholarly-http.mjs --collation",
    "test:study-activity": "tsx --test src/lib/study-activity-policy.test.ts && node ./test-study-activity.mjs",
    "test:learning-stages": "tsx --test src/lib/learning-stage-policy.test.ts && node ./test-learning-stages.mjs",
    "test:practice-reports": "node ./test-practice-reports.mjs",
    "test:word-practice": "node ./test-practice-reports.mjs --word-practice",
    "test:recitation-pages": "tsx --test src/lib/recitation-pages.test.ts",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test:recitations": "tsx --test src/lib/recitation.test.ts src/lib/recitation-safety.test.ts",
    "test:assessments": "tsx --test src/lib/assessment-policy.test.ts src/lib/assessment-audio-freeze.test.ts",
    "assessment-reviewer": "tsx scripts/assessment-reviewer.ts",
    "assessment-retention-cleanup": "tsx scripts/assessment-retention-cleanup.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test:scholarly": "node ./test-scholarly.mjs && node ./test-scholarly-http.mjs && pnpm run test:scholarly:preview",
    "test:scholarly:preview": "node ./test-scholarly-http.mjs --preview && pnpm --filter @workspace/mateen-platform run test:scholarly:preview",
    "test:scholarly:http": "node ./test-scholarly-http.mjs",
    "test:scholarly:import": "node ./test-scholarly-http.mjs --prepared-import",
    "evaluate:scholarly:content": "tsx scripts/evaluate-scholarly-content.ts",
    "test:assessment:integration": "node ./test-assessment-audio-integration.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.74",
    "@clerk/shared": "^4.37.1",
    "@google-cloud/storage": "^8.2.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "http-proxy-middleware": "^4.2.0",
    "parse5": "^8.0.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
