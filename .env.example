# Copy to .env.local and replace placeholders with your OWN development settings.
# Never commit .env.local. This is a Bash-sourceable template, not working credentials.

DATABASE_URL='postgresql://mateen:CHANGE_ME@localhost:5432/mateen_dev'
CLERK_PUBLISHABLE_KEY='pk_test_REPLACE_WITH_YOUR_DEVELOPMENT_KEY'
VITE_CLERK_PUBLISHABLE_KEY='pk_test_REPLACE_WITH_THE_SAME_DEVELOPMENT_KEY'
CLERK_SECRET_KEY='sk_test_REPLACE_WITH_YOUR_DEVELOPMENT_KEY'

# Optional live AI providers. Empty means unavailable, not a demo response.
OPENROUTER_API_KEY=''
NVIDIA_API_KEY=''

# Do not set VITE_CLERK_PROXY_URL for the local development-key flow.
# Do not put server secret keys in VITE_* variables.

# Default preserves Replit managed storage. Use 'local' only for standalone disk.
PRIVATE_STORAGE_PROVIDER='replit'
# For local: absolute directory OUTSIDE this repository, owned by the API user.
# Example: /home/YOUR_USER/.local/share/mateen-private (never a public/static directory).
# Created with mode 0700; files and generated signing key use 0600.
LOCAL_PRIVATE_STORAGE_DIR=''
# Browser-facing origin, not the API's internal port; use HTTPS except loopback.
# The README Caddy proxy uses http://localhost:3000 and proxies /api.
LOCAL_PRIVATE_STORAGE_ORIGIN='http://localhost:3000'
# Replit-only settings. Paths alone do not authorise local access.
PRIVATE_OBJECT_DIR=''
PUBLIC_OBJECT_SEARCH_PATHS=''

# PORT and BASE_PATH are supplied separately in the README start commands.
